---
import Base from '../../layouts/Base.astro';
import Score from '../../components/Score.astro';
import { getCollection, render } from 'astro:content';
import { getBreakfasts, postUrl, formatDate, flagUrl } from '../../lib.js';

export async function getStaticPaths() {
  const posts = await getCollection('breakfasts');
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { country, dish, date, rating, ratingNote, images, flag, about } = post.data;
const aboutParas = (about ?? '').split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);

const all = await getBreakfasts();
const i = all.findIndex((p) => p.id === post.id);
const prev = all[i - 1];
const next = all[i + 1];
---
<Base title={`${dish} from ${country}`} description={`${dish}: the breakfast we cooked for ${country}, with our family’s rating and the full recipe.`} image={images[0]}>
  <article class="post">
    <header class="post-header">
      <p class="kicker"><a href="/">All breakfasts</a></p>
      <div class="post-title">
        {flag && <img class="flag flag-lg" src={flagUrl(flag)} alt={`Flag of ${country}`} width="96" height="72" />}
        <h1>{country}</h1>
      </div>
      <div class="post-score">
        <Score value={rating} size="lg" />
        <div>
          <p class="post-dish">{dish}</p>
          <p class="post-note">{ratingNote ?? 'Family average out of 5'}</p>
          <p class="post-date">Posted {formatDate(date)}</p>
        </div>
      </div>
    </header>

    {images.map((src, n) => (
      <figure class="post-photo">
        <img src={src} alt={n === 0 ? `${dish} from ${country}` : `Another photo of the ${dish.toLowerCase()}`} loading={n === 0 ? 'eager' : 'lazy'} />
      </figure>
    ))}

    {aboutParas.length > 0 && (
      <section class="about-country" aria-labelledby="about-heading">
        <h2 id="about-heading">About {country}</h2>
        {aboutParas.map((p) => <p>{p}</p>)}
      </section>
    )}

    <div class="prose">
      <Content />
    </div>

    <nav class="post-nav" aria-label="More breakfasts">
      {prev ? <a href={postUrl(prev)} rel="prev"><span>Previous</span>{prev.data.country}</a> : <span />}
      {next ? <a href={postUrl(next)} rel="next"><span>Next</span>{next.data.country}</a> : <span />}
    </nav>
  </article>
</Base>
