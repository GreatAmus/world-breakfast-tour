---
import Base from '../../layouts/Base.astro';
import Tile from '../../components/Tile.astro';
import { getBreakfasts } from '../../lib.js';
import { letterOf } from '../../data/countries.js';

const posts = await getBreakfasts();
const letters = [...new Set(posts.map((p) => letterOf(p.data.country)))];
// Most recent letter first, so new posts are near the top.
const groups = letters.map((l) => ({ l, items: posts.filter((p) => letterOf(p.data.country) === l) })).reverse();
---
<Base title="All breakfasts" description="Every breakfast we've made so far, from A to Z.">
  <section class="page-head">
    <h1>All breakfasts</h1>
    <p class="lede">Every breakfast we’ve made so far. The newest letter is at the top.</p>
  </section>
  {groups.map((g) => (
    <section class="group" aria-labelledby={`letter-${g.l}`}>
      <h2 class="group-letter" id={`letter-${g.l}`}>{g.l}</h2>
      <div class="tiles">
        {g.items.map((post) => <Tile post={post} />)}
      </div>
    </section>
  ))}
</Base>
