---
import Base from '../layouts/Base.astro';
import { getBreakfasts, postUrl, formatScore, scoreTone, RED_BELOW, GREEN_FROM } from '../lib.js';
const posts = (await getBreakfasts()).filter((p) => p.data.rating !== undefined).sort((a,b) => b.data.rating - a.data.rating || a.data.country.localeCompare(b.data.country));
let rank = 0;
const rows = posts.map((p,n) => { if (n === 0 || p.data.rating !== posts[n-1].data.rating) rank = n+1; return {p,rank}; });
---
<Base title="Leaderboard" description="Our family’s breakfast ratings and what we would eat again.">
  <section class="page-head">
    <h1>Family favorites</h1>
    <p class="lede">How the breakfasts ranked at our table. <a href="/about/#rating-heading">How we rate</a>.</p>
    <ul class="legend" aria-label="Score colors"><li><span class="swatch tone-high"></span>Breakfast rotation: {GREEN_FROM.toFixed(1)} and up</li><li><span class="swatch tone-mid"></span>Would eat again: {RED_BELOW.toFixed(1)} to {(GREEN_FROM - 0.1).toFixed(1)}</li><li><span class="swatch tone-low"></span>Wouldn’t eat again: under {RED_BELOW.toFixed(1)}</li></ul>
  </section>
  <div class="table-wrap"><table class="board"><thead><tr><th scope="col">Rank</th><th scope="col">Country / dish</th><th scope="col" id="score-heading">Family score / 5</th></tr></thead><tbody id="score-rows">
    {rows.map(({p,rank}) => <tr data-country={p.data.country} data-rating={p.data.rating}>
      <td class="rank">{rank}</td><td><a href={postUrl(p)}>{p.data.country}</a><span class="board-dish">{p.data.dish}</span>{p.data.ratingNote && <span class="board-note">{p.data.ratingNote}</span>}</td>
      <td class="board-score"><span class={`bar tone-${scoreTone(p.data.rating)}`} style={`--w:${p.data.rating / 5}`} aria-hidden="true"></span><span class="num">{formatScore(p.data.rating)}</span></td>
    </tr>)}
  </tbody></table></div>
</Base>
