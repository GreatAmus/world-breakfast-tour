---
import Base from '../layouts/Base.astro';
import Score from '../components/Score.astro';
import { getBreakfasts, postUrl, formatDate, flagUrl, excerpt } from '../lib.js';
import { countries, letterOf } from '../data/countries.js';

const SHOW = 8; // how many recent posts to preview

const posts = await getBreakfasts();
const done = new Set(posts.map((p) => p.data.country));
const total = new Set([...countries, ...done]).size;
const recent = [...posts]
  .sort((a, b) => b.data.date - a.data.date || a.data.country.localeCompare(b.data.country))
  .slice(0, SHOW);

const letters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('').map((l) => {
  const all = countries.filter((c) => letterOf(c) === l);
  const cooked = all.filter((c) => done.has(c)).length;
  const state = all.length === 0 ? 'none' : cooked === all.length ? 'done' : cooked > 0 ? 'part' : 'todo';
  return { l, all: all.length, cooked, state, pct: all.length ? Math.round((cooked / all.length) * 100) : 0 };
});
const label = (x) => (x.state === 'none' ? `${x.l}: no countries` : `${x.l}: ${x.cooked} of ${x.all} countries cooked`);
---
<Base>
  <section class="hero">
    <h1>Eating around the world from A–Z</h1>
    <p class="hero-sub">A magical breakfast journey for the whole family</p>
    <p class="lede">So far: {posts.length} down, {total - posts.length} to go. <a href="/about/">Read about the project</a>.</p>
    <ol class="alphabet" aria-label="Progress by letter">
      {letters.map((x) => (
        <li class={`letter letter-${x.state}`} style={`--p:${x.pct}%`} title={label(x)}>
          {x.state === 'none' ? <span>{x.l}</span> : <a href={`/passport/#${x.l}`} aria-label={label(x)}>{x.l}</a>}
        </li>
      ))}
    </ol>
  </section>

  <section aria-labelledby="recent-heading">
    <h2 class="group-letter group-title" id="recent-heading">Latest recipes</h2>
    <ul class="previews">
      {recent.map((post) => (
        <li>
          <a class="preview" href={postUrl(post)}>
            <span class="preview-photo">
              {post.data.images[0] && <img src={post.data.images[0]} alt={`${post.data.dish} from ${post.data.country}`} loading="lazy" decoding="async" />}
            </span>
            <span class="preview-text">
              <span class="preview-date">{formatDate(post.data.date)}</span>
              <span class="preview-country">
                {post.data.flag && <img class="flag flag-sm" src={flagUrl(post.data.flag)} alt="" width="24" height="18" loading="lazy" />}
                {post.data.country}
              </span>
              <span class="preview-dish">{post.data.dish}</span>
              <span class="preview-excerpt">{excerpt(post)}</span>
              <span class="preview-foot">
                <Score value={post.data.rating} />
                <span class="preview-more">Read more</span>
              </span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <p class="browse">
    <a class="button" href="/breakfasts/">See all {posts.length} breakfasts</a>
  </p>
</Base>
